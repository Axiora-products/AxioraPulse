# ==============================================================================
# AxioraPulse — Super Admin Console Configuration
# ==============================================================================

# Backend Port
PORT=8001
ENVIRONMENT=development

# Shared Database Connection
# Points to the same database as the main app.
# Note: Use 'localhost' or '127.0.0.1' when running local Python servers outside of Docker,
# or 'pulse-db' if dockerized.
DATABASE_URL=postgresql://postgres:root@localhost:5432/nexpulse

# CORS settings for the super admin frontend
ADMIN_FRONTEND_URL=http://localhost:5175

# Separate Cognito User Pool configuration for Super Admins
SUPER_ADMIN_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
SUPER_ADMIN_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
SUPER_ADMIN_COGNITO_REGION=ap-south-1

# Enable mock Cognito mode for local testing without AWS Cognito
# Set to 'false' in production.
MOCK_COGNITO=true
MOCK_COGNITO_SECRET=mock-secret-key-1234567890
SECRET_KEY=super-admin-development-signing-secret-key-987654321
