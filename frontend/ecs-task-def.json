{
  "family": "pulse-frontend-${ENV}",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "${ROLE_ARN}",
  "taskRoleArn": "${ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "FrontendContainer",
      "image": "FRONTEND_IMAGE",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "BACKEND_INTERNAL_URL",
          "value": "backend.${ENV}.local:8000"
        },
        {
          "name": "VITE_APP_ENV",
          "value": "${ENV}"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/pulse-frontend-${ENV}",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://localhost:80/ || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "secrets": [
        {
          "name": "VITE_SENTRY_DSN",
          "valueFrom": "arn:aws:ssm:ap-south-1:${ACCOUNT_ID}:parameter/axiorapulse/${ENV}/VITE_SENTRY_DSN"
        },
        {
          "name": "VITE_SENTRY_TRACES_SAMPLE_RATE",
          "valueFrom": "arn:aws:ssm:ap-south-1:${ACCOUNT_ID}:parameter/axiorapulse/${ENV}/VITE_SENTRY_TRACES_SAMPLE_RATE"
        },
        {
          "name": "VITE_SENTRY_PROFILES_SAMPLE_RATE",
          "valueFrom": "arn:aws:ssm:ap-south-1:${ACCOUNT_ID}:parameter/axiorapulse/${ENV}/VITE_SENTRY_PROFILES_SAMPLE_RATE"
        }
      ]
    }
  ]
}
